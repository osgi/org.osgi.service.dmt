            <fo:block id="i2939626">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>117.11.7</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Life Cycle Event Properties</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">All Life Cycle events must have the properties defined in the
      following table.</fo:block>
               <fo:block xmlns:rx="http://www.renderx.com/XSL/Extensions" start-indent="0pt">
                  <fo:block space-before.minimum="0.5em"
                            space-before.optimum="1em"
                            space-before.maximum="2em"
                            space-after.minimum="0.5em"
                            space-after.optimum="1em"
                            space-after.maximum="2em"
                            keep-together.within-column="auto"
                            id="service.dmt-event.properties.lifecycle">
                     <fo:block xmlns:d="http://docbook.org/ns/docbook"
                               xmlns:xlink="http://www.w3.org/1999/xlink"
                               space-before.optimum="5pt"
                               space-before.minimum="5pt"
                               space-before.maximum="5pt"
                               font-weight="normal"
                               font-size="9pt"
                               hyphenate="false"
                               space-after.minimum="0.4em"
                               space-after.optimum="0.6em"
                               space-after.maximum="0.8em"
                               start-indent="0pt"
                               font-family="Proforma-Book,ArialUnicodeMS"
                               font-style="italic"
                               keep-with-next.within-column="always">
                        <fo:list-block provisional-distance-between-starts="1in"
                                       provisional-label-separation="0.090in">
                           <fo:list-item>
                              <fo:list-item-label end-indent="label-end()" text-align="start">
                                 <fo:block>Table 117.10</fo:block>
                              </fo:list-item-label>
                              <fo:list-item-body start-indent="body-start()">
                                 <fo:block>Event Properties for Life Cycle Events</fo:block>
                              </fo:list-item-body>
                           </fo:list-item>
                        </fo:list-block>
                     </fo:block>
                     <fo:table border-before-width.conditionality="retain"
                               border-collapse="collapse"
                               table-layout="fixed"
                               width="100%">
                        <fo:table-column column-number="1" column-width="proportional-column-width(1.5)"/>
                        <fo:table-column column-number="2" column-width="proportional-column-width(1)"/>
                        <fo:table-column column-number="3" column-width="proportional-column-width(1.5)"/>
                        <fo:table-column column-number="4" column-width="proportional-column-width(3)"/>
                        <fo:table-header start-indent="0pt" end-indent="0pt">
                           <fo:table-row keep-together.within-column="always"
                                         keep-with-next.within-column="always"
                                         font-family="ProductusSemibold,ArialUnicodeMS">
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>Property Name</fo:block>
                              </fo:table-cell>
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>Type</fo:block>
                              </fo:table-cell>
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>Dmt Event</fo:block>
                              </fo:table-cell>
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>Description</fo:block>
                              </fo:table-cell>
                           </fo:table-row>
                        </fo:table-header>
                        <fo:table-body start-indent="0pt" end-indent="0pt">
                           <fo:table-row keep-together.within-column="always">
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>
                                    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">nodes</fo:inline>
                                 </fo:block>
                              </fo:table-cell>
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>
                                    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">String[]</fo:inline>
                                 </fo:block>
                              </fo:table-cell>
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>
                                    <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                   xmlns:xlink="http://www.w3.org/1999/xlink"
                                                   internal-destination="org.osgi.service.dmt.DmtEvent.getNodes--">
                                       <fo:inline color="blue"
                                                  font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                                  letter-spacing="0.08em"
                                                  hyphenate="false">getNodes()</fo:inline>
                                    </fo:basic-link>
                                 </fo:block>
                              </fo:table-cell>
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>
                                    <fo:block space-before.optimum="5pt"
                                              space-before.minimum="5pt"
                                              space-before.maximum="5pt">The absolute URIs of each affected node. This is
              the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                                  font-size="9pt"
                                                  letter-spacing="0.08em">nodeUri</fo:inline> parameter of the Dmt API methods. The
              order of the URIs in the array corresponds to the chronological
              order of the operations. In case of a recursive delete or copy,
              only the session root URI is present in the array.
              </fo:block>
                                 </fo:block>
                              </fo:table-cell>
                           </fo:table-row>
                           <fo:table-row keep-together.within-column="always">
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>
                                    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">newnodes</fo:inline>
                                 </fo:block>
                              </fo:table-cell>
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>
                                    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">String[]</fo:inline>
                                 </fo:block>
                              </fo:table-cell>
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>
                                    <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                   xmlns:xlink="http://www.w3.org/1999/xlink"
                                                   internal-destination="org.osgi.service.dmt.DmtEvent.getNewNodes--">
                                       <fo:inline color="blue"
                                                  font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                                  letter-spacing="0.08em"
                                                  hyphenate="false">getNewNodes()</fo:inline>
                                    </fo:basic-link>
                                 </fo:block>
                              </fo:table-cell>
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>
                                    <fo:block space-before.optimum="5pt"
                                              space-before.minimum="5pt"
                                              space-before.maximum="5pt">The absolute URIs of new renamed or copied nodes.
              Only the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                                  font-size="9pt"
                                                  letter-spacing="0.08em">RENAMED</fo:inline> and <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                                  font-size="9pt"
                                                  letter-spacing="0.08em">COPIED</fo:inline> events
              have this property.</fo:block>
                                    <fo:block space-before.optimum="5pt"
                                              space-before.minimum="5pt"
                                              space-before.maximum="5pt">The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                                  font-size="9pt"
                                                  letter-spacing="0.08em">newnodes</fo:inline> array
              runs parallel to the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                                  font-size="9pt"
                                                  letter-spacing="0.08em">nodes</fo:inline> array. In case of a
              rename, <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                                  font-size="9pt"
                                                  letter-spacing="0.08em">newnodes[i]</fo:inline> must contains the new name of
              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                                  font-size="9pt"
                                                  letter-spacing="0.08em">nodes[i]</fo:inline>, and in case of a copy,
              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                                  font-size="9pt"
                                                  letter-spacing="0.08em">newnodes[i]</fo:inline> is the URI to which
              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                                  font-size="9pt"
                                                  letter-spacing="0.08em">nodes[i]</fo:inline> was copied.</fo:block>
                                 </fo:block>
                              </fo:table-cell>
                           </fo:table-row>
                        </fo:table-body>
                     </fo:table>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block id="d1184e3550">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>117.11.8</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Example Event Delivery</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The example in this section shows the change of a non-trivial tree
      and the events that these changes will cause.</fo:block>
               <fo:block space-before.minimum="0.5em"
                         space-before.optimum="1em"
                         space-before.maximum="2em"
                         space-after.minimum="0.5em"
                         space-after.optimum="1em"
                         space-after.maximum="2em"
                         keep-together.within-column="always"
                         id="i1768822">
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            font-weight="normal"
                            font-size="9pt"
                            hyphenate="false"
                            space-after.minimum="0.4em"
                            space-after.optimum="0.6em"
                            space-after.maximum="0.8em"
                            start-indent="0pt"
                            font-family="Proforma-Book,ArialUnicodeMS"
                            font-style="italic"
                            keep-with-next.within-column="always">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block>Figure 117.21</fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>Example DMT before</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block id="d1184e3555" text-align="center">
                     <fo:external-graphic src="url(file:///home/stbischof/git/OSGI_MIGRATE/osgi_target/org.osgi.service.dmt/spec/org.osgi.spec.service.dmt/src/main/resources/spec/dmt-example-before.svg)"
                                          width="auto"
                                          height="auto"
                                          content-width="5.011in"
                                          content-height="1.933in"
                                          text-align="center"/>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">For example, in a given session, when the DMT in <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="i1768822">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">Figure 117.21</fo:inline>
                  </fo:basic-link> is modified with the following operations:</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d1184e3562">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e3563">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>Open atomic session 42 on the root URI</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e3565">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>Add node <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">./A/B/C</fo:inline>
                           </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e3569">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>Add node <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">./A/B/C/D</fo:inline>
                           </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e3573">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>Rename <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">./M/n1</fo:inline> to./M/n2</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e3578">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>Copy <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">./M/n2</fo:inline> to <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">./M/n3</fo:inline>
                           </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e3584">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>Delete node <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">./P/Q</fo:inline>
                           </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e3588">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>Add node <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">./P/Q</fo:inline>
                           </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e3592">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>Delete node <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">./P/Q</fo:inline>
                           </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e3596">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>Replace <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">./X/Y/z</fo:inline> with 3</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e3601">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>Commit</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e3603">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>Close</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
               <fo:block space-before.minimum="0.5em"
                         space-before.optimum="1em"
                         space-before.maximum="2em"
                         space-after.minimum="0.5em"
                         space-after.optimum="1em"
                         space-after.maximum="2em"
                         keep-together.within-column="always"
                         id="d1184e3605">
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            font-weight="normal"
                            font-size="9pt"
                            hyphenate="false"
                            space-after.minimum="0.4em"
                            space-after.optimum="0.6em"
                            space-after.maximum="0.8em"
                            start-indent="0pt"
                            font-family="Proforma-Book,ArialUnicodeMS"
                            font-style="italic"
                            keep-with-next.within-column="always">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block>Figure 117.22</fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>Example DMT after</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block id="d1184e3607" text-align="center">
                     <fo:external-graphic src="url(file:///home/stbischof/git/OSGI_MIGRATE/osgi_target/org.osgi.service.dmt/spec/org.osgi.spec.service.dmt/src/main/resources/spec/dmt-example-after.svg)"
                                          width="auto"
                                          height="auto"
                                          content-width="5.011in"
                                          content-height="1.933in"
                                          text-align="center"/>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">When the Dmt Session is opened, the following event is
      published:</fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d1184e3611">SESSION_OPENED {
        session.id = 42
        session.rooturi=.
        session.principal=null
        session.locktype=2
        timestamp=1313411544752
        bundle  =&lt;Bundle&gt;
        bundle.signer=[]
        bundle.symbolicname"com.acme.bundle"
        bundle.version=1.2.4711
        bundle.id=442
        ...
}</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">When the Dmt Session is closed (assuming it is atomic), the
      following events are published:</fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d1184e3613">ADDED {
        nodes = [./A/B/C, ./A/B/C/D ]       # note the coalescing
        session.id = 42
        ...
}
RENAMED {
        nodes = [ ./M/n1 ]
        newnodes = [ ./M/n2 ]
        session.id = 42
        ...
}
COPIED {
        nodes = [ ./M/n2 ]
        newnodes = [ ./M/n3 ]
        session.id = 42
        ...
}
DELETED {
        nodes = [ ./P/Q ]
        session.id = 42
        ...
}
ADDED {
        nodes = [ ./P/Q ]
        session.id = 42
        ...
}
DELETED {
        nodes = [ ./P/Q ]
        session.id = 42
        ...
}
REPLACED {
        nodes = [ ./X/Y/z ]
        session.id = 42
        ...
}
SESSION_CLOSED {
        session.id = 42
        session.rooturi=.
        session.principal=null
        session.locktype=2
        ...
}</fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="service.dmt.osgiobjectmodeling">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">OSGi Object Modeling</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>117.12</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>OSGi Object Modeling</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block id="d1184e3616">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>117.12.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Object Models</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Management protocols define only half the picture; the object
      models associated with a particular protocol are the other half. Object
      models are always closely associated with a remote management protocol
      since they are based on the data types and actions that are defined in
      the protocol. Even small differences between the data types of a
      protocol and its differences make accurate mapping between protocols
      virtually impossible. It is therefore necessary to make the distinction
      between <fo:inline font-style="italic">native</fo:inline> and <fo:inline font-style="italic">foreign</fo:inline>
      protocols for an object model.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">A native protocol for an object model originates from the same
      specification organization. For example, OMA DM consists of a protocol
      based on SyncML and a number of object models that define the structure
      and behavior of the nodes of the DMT. The FOMA specification defines an
      OMA DM native object model, it defines how firmware management is done.
      This is depicted in <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="i2869529">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">Figure 117.23</fo:inline>
                  </fo:basic-link>.</fo:block>
               <fo:block space-before.minimum="0.5em"
                         space-before.optimum="1em"
                         space-before.maximum="2em"
                         space-after.minimum="0.5em"
                         space-after.optimum="1em"
                         space-after.maximum="2em"
                         keep-together.within-column="always"
                         id="i2869529">
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            font-weight="normal"
                            font-size="9pt"
                            hyphenate="false"
                            space-after.minimum="0.4em"
                            space-after.optimum="0.6em"
                            space-after.maximum="0.8em"
                            start-indent="0pt"
                            font-family="Proforma-Book,ArialUnicodeMS"
                            font-style="italic"
                            keep-with-next.within-column="always">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block>Figure 117.23</fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>Device Management Architecture</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block id="d1184e3630" text-align="center">
                     <fo:external-graphic src="url(file:///home/stbischof/git/OSGI_MIGRATE/osgi_target/org.osgi.service.dmt/spec/org.osgi.spec.service.dmt/src/main/resources/spec/device-management-architecture.svg)"
                                          width="auto"
                                          height="auto"
                                          content-width="5.236in"
                                          content-height="2.887in"
                                          text-align="center"/>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">If an object implements a standardized data model it must be
      visible through its <fo:inline font-style="italic">native</fo:inline> Protocol Adapter, that
      is the Protocol Adapter that belongs to the object model's standard. For
      example, an <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">ExecutionUnit</fo:inline> node defined in UPnP Device
      Management could be implemented as a bundle, exposed through a Data
      Plugin for the Dmt Admin service, and then translated by its native UPnP
      Protocol Adapter.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">If an object is present in the Dmt Admin service it is also
      available to <fo:inline font-style="italic">foreign</fo:inline> Protocol Adapters. A foreign
      Protocol Adapter is any Protocol Adapter except its native Protocol
      Adapter. For example, the Broadband Forum's <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">ExecutionUnit</fo:inline>
      could be browsed on the foreign OMA DM protocol.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">In a foreign Protocol Adapter the object model should be
      <fo:inline font-style="italic">browsable</fo:inline> but it would not map to one of its native
      object models. Browsable means that the information is available to the
      Protocol Adapter's remote manager but not recognized as a standard model
      for the manager. Browse can include, potentially limited,
      manipulation.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">In a native Protocol Adapter it is paramount that the mapping from
      the DMT to the native object is fully correct. It is the purpose of this
      part of the Dmt Admin service specification to allow the native Protocol
      Adapter to map the intentions of the Plugin without requiring knowledge
      of the specific native object model. That is, a TR-069 Plugin
      implementing a WAN interface must be available over the TR-069 protocol
      without the Protocol Adapter having explicit knowledge about the WAN
      interfaces object models from Broadband Forum.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Therefore, the following use cases are recognized:</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d1184e3651">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e3652">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Foreign Mapping</fo:inline> - Foreign mapping can is
          best-effort as there is no object model to follow. Each Protocol
          Adapter must define how the Dmt Admin model is mapped for this
          browse mode.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e3656">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Native Mapping</fo:inline> - Native mapping must be
          100% correct. As it is impossible automatically map DMTs to
          arbitrary protocols this specification provides the concept of a
          mapping model that allows a Plugin to instruct its native Protocol
          Adapter using Meta Nodes.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
            </fo:block>
            <fo:block id="service.dmt.protocolmapping">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>117.12.2</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Protocol Mapping</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The OSGi Working Group specifies an Execution Environment that can be
      used as a basis for residential gateways, mobiles, or other devices.
      This raises the issue how to expose the manageability of an OSGi device
      and the <fo:inline font-style="italic">objects</fo:inline>, the units of manageability, that
      are implemented through Plugins. Ideally, an object should be able to
      expose its management interface once and then Protocol Adapters convert
      the management interface to specific device management stacks. For
      example, an object can be exposed through the Dmt Admin service where
      then a TR-069 Protocol Adapter maps the DMT to the TR-069 Remote
      Procedure Calls (RPC).</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
                  <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="i2869627">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">Figure 117.24</fo:inline>
                  </fo:basic-link> shows an example of a TR-069 Protocol
      Adapter and an OMA DM Protocol Adapter. The TR-069 Protocol Adapter
      should be able to map native TR-069 objects in the DMT (the
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Software Modules Impl</fo:inline> in the figure) to Broadband Forum's
      object models. It should also be able to browse the foreign DMT and
      other objects that are not defined in Broadband forum but can be
      accessed with the TR-069 RPCs.</fo:block>
               <fo:block start-indent="0pt">
                  <fo:block space-before.minimum="0.5em"
                            space-before.optimum="1em"
                            space-before.maximum="2em"
                            space-after.minimum="0.5em"
                            space-after.optimum="1em"
                            space-after.maximum="2em"
                            keep-together.within-column="always"
                            id="i2869627">
                     <fo:block xmlns:d="http://docbook.org/ns/docbook"
                               xmlns:xlink="http://www.w3.org/1999/xlink"
                               space-before.optimum="5pt"
                               space-before.minimum="5pt"
                               space-before.maximum="5pt"
                               font-weight="normal"
                               font-size="9pt"
                               hyphenate="false"
                               space-after.minimum="0.4em"
                               space-after.optimum="0.6em"
                               space-after.maximum="0.8em"
                               start-indent="0pt"
                               font-family="Proforma-Book,ArialUnicodeMS"
                               font-style="italic"
                               keep-with-next.within-column="always">
                        <fo:list-block provisional-distance-between-starts="1in"
                                       provisional-label-separation="0.090in">
                           <fo:list-item>
                              <fo:list-item-label end-indent="label-end()" text-align="start">
                                 <fo:block>Figure 117.24</fo:block>
                              </fo:list-item-label>
                              <fo:list-item-body start-indent="body-start()">
                                 <fo:block>Implementing &amp; Browsing</fo:block>
                              </fo:list-item-body>
                           </fo:list-item>
                        </fo:list-block>
                     </fo:block>
                     <fo:block id="d1184e3673" text-align="center">
                        <fo:external-graphic src="url(file:///home/stbischof/git/OSGI_MIGRATE/osgi_target/org.osgi.service.dmt/spec/org.osgi.spec.service.dmt/src/main/resources/spec/implementing-browsing.svg)"
                                             width="auto"
                                             height="auto"
                                             content-width="6.260in"
                                             content-height="2.326in"
                                             text-align="center"/>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">A <fo:inline font-style="italic">Protocol Mapping</fo:inline> is a document that
      describes the default mapping and the native mechanism for exact
      mapping.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The following sections specify how Plugins must implement an
      object model that is exposed through the Dmt Admin service. This model
      is limited from the full Dmt Admin service capabilities so that for each
      protocol it is possible to specify a default mapping for browsing as
      well as a mechanism to ensure that special conversion requirements can
      be communicated from a Plugin to its native Protocol Adapter.</fo:block>
            </fo:block>
            <fo:block id="i2836536">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>117.12.3</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Hierarchy</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The Dmt Admin model provides an hierarchy of
      <fo:inline font-style="italic">nodes</fo:inline>. Each node has a <fo:inline font-style="italic">type</fo:inline>
      that is reflected by its Meta Node. A node is addressed with a URI. The
      flexibility of the Dmt Admin service allows a large number of
      constructs, for example, the name of the node can be used as a
      <fo:inline font-style="italic">value</fo:inline>, a feature that some management standards
      support. To simplify mapping to foreign Protocol Adapters, some of the
      fundamental constructs have been defined in the following
      sections.</fo:block>
            </fo:block>
            <fo:block id="d1184e3691">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>117.12.4</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>General Restriction Guidelines</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The Dmt Admin service provides a very rich tool to model complex
      object structures. Many choices can be made that would make it very hard
      to browse DMTs on non-OMA DM protocols or make the DMT hard to use
      through the Dmt Admin service. As Plugins can always signal special case
      handling to their native Protocol Adapter, any object model design
      should strive to be easy to use for the developers and managers.
      Therefore, this section provides a number of guidelines for the design
      of such object models that will improve the browsing experience for many
      Protocol Adapters.</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d1184e3694">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e3695">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Reading of a node must not change the state of a
          device</fo:inline> - Management systems must be able to browse a tree
          without causing any side effects. If reading modified the DMT, a
          management system would have no way to warn the user that the system
          is modified. There are a number of technical reasons as well (race
          conditions, security holes, and eventing) but the most important
          reason is the browsability of the device.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e3699">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">No use of recursive structures</fo:inline> - The Dmt
          Admin service provides a very rich tree model that has no problem
          with recursion. However, this does not have to be true for other
          models. To increase the changes that a model is browsable on another
          device it is strongly recommended to prevent recursive models. For
          example, TR-069 cannot handle recursive models.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e3703">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Only a single format per meta node</fo:inline> -
          Handling different types in different nodes simplifies the data
          conversion for both foreign and native protocols. Having a single
          choice from the Meta Node makes the conversion straightforward and
          does not require guessing.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e3707">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">All nodes must provide a Meta Node</fo:inline> -
          Conversion without a Meta Node makes the conversion very hard since
          object model schemas are often not available in the Protocol
          Adapter.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e3711">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Naming</fo:inline> - Structured node members must
          have names only consisting of <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">[a-zA-Z0-9]</fo:inline> and must
          always start with a character <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">[a-zA-z]</fo:inline>. Member names
          must be different regardless of the case, that is <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Abc</fo:inline>
          and <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">ABC</fo:inline> must not both be members of the same structured
          node. The reason for this restriction is that it makes it more
          likely that the chosen names are compatible with the supported
          protocols and do not require escaping.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e3723">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Typing</fo:inline> - Restrict the used formats to
          formats that maximize both the interoperability as the ease of use
          for Java developers. The following type are widely supported and are
          easy to use from Java:</fo:block>
                           <fo:list-block provisional-label-separation="0.2em"
                                          provisional-distance-between-starts="12pt"
                                          id="d1184e3727">
                              <fo:list-item space-before.optimum="2pt"
                                            space-before.minimum="2pt"
                                            space-before.maximum="2pt"
                                            id="d1184e3728">
                                 <fo:list-item-label end-indent="label-end()">
                                    <fo:block>•</fo:block>
                                 </fo:list-item-label>
                                 <fo:list-item-body start-indent="body-start()">
                                    <fo:block>
                                       <fo:block>
                                          <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                         xmlns:xlink="http://www.w3.org/1999/xlink"
                                                         internal-destination="org.osgi.service.dmt.DmtData.FORMAT_STRING">
                                             <fo:inline color="blue"
                                                        font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                                        letter-spacing="0.08em"
                                                        hyphenate="false">FORMAT_STRING</fo:inline>
                                          </fo:basic-link>
                                       </fo:block>
                                    </fo:block>
                                 </fo:list-item-body>
                              </fo:list-item>
                              <fo:list-item space-before.optimum="2pt"
                                            space-before.minimum="2pt"
                                            space-before.maximum="2pt"
                                            id="d1184e3731">
                                 <fo:list-item-label end-indent="label-end()">
                                    <fo:block>•</fo:block>
                                 </fo:list-item-label>
                                 <fo:list-item-body start-indent="body-start()">
                                    <fo:block>
                                       <fo:block>
                                          <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                         xmlns:xlink="http://www.w3.org/1999/xlink"
                                                         internal-destination="org.osgi.service.dmt.DmtData.FORMAT_BOOLEAN">
                                             <fo:inline color="blue"
                                                        font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                                        letter-spacing="0.08em"
                                                        hyphenate="false">FORMAT_BOOLEAN</fo:inline>
                                          </fo:basic-link>
                                       </fo:block>
                                    </fo:block>
                                 </fo:list-item-body>
                              </fo:list-item>
                              <fo:list-item space-before.optimum="2pt"
                                            space-before.minimum="2pt"
                                            space-before.maximum="2pt"
                                            id="d1184e3734">
                                 <fo:list-item-label end-indent="label-end()">
                                    <fo:block>•</fo:block>
                                 </fo:list-item-label>
                                 <fo:list-item-body start-indent="body-start()">
                                    <fo:block>
                                       <fo:block>
                                          <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                         xmlns:xlink="http://www.w3.org/1999/xlink"
                                                         internal-destination="org.osgi.service.dmt.DmtData.FORMAT_INTEGER">
                                             <fo:inline color="blue"
                                                        font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                                        letter-spacing="0.08em"
                                                        hyphenate="false">FORMAT_INTEGER</fo:inline>
                                          </fo:basic-link>
                                       </fo:block>
                                    </fo:block>
                                 </fo:list-item-body>
                              </fo:list-item>
                              <fo:list-item space-before.optimum="2pt"
                                            space-before.minimum="2pt"
                                            space-before.maximum="2pt"
                                            id="d1184e3737">
                                 <fo:list-item-label end-indent="label-end()">
                                    <fo:block>•</fo:block>
                                 </fo:list-item-label>
                                 <fo:list-item-body start-indent="body-start()">
                                    <fo:block>
                                       <fo:block>
                                          <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                         xmlns:xlink="http://www.w3.org/1999/xlink"
                                                         internal-destination="org.osgi.service.dmt.DmtData.FORMAT_LONG">
                                             <fo:inline color="blue"
                                                        font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                                        letter-spacing="0.08em"
                                                        hyphenate="false">FORMAT_LONG</fo:inline>
                                          </fo:basic-link>
                                       </fo:block>
                                    </fo:block>
                                 </fo:list-item-body>
                              </fo:list-item>
                              <fo:list-item space-before.optimum="2pt"
                                            space-before.minimum="2pt"
                                            space-before.maximum="2pt"
                                            id="d1184e3740">
                                 <fo:list-item-label end-indent="label-end()">
                                    <fo:block>•</fo:block>
                                 </fo:list-item-label>
                                 <fo:list-item-body start-indent="body-start()">
                                    <fo:block>
                                       <fo:block>
                                          <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                         xmlns:xlink="http://www.w3.org/1999/xlink"
                                                         internal-destination="org.osgi.service.dmt.DmtData.FORMAT_FLOAT">
                                             <fo:inline color="blue"
                                                        font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                                        letter-spacing="0.08em"
                                                        hyphenate="false">FORMAT_FLOAT</fo:inline>
                                          </fo:basic-link>
                                       </fo:block>
                                    </fo:block>
                                 </fo:list-item-body>
                              </fo:list-item>
                              <fo:list-item space-before.optimum="2pt"
                                            space-before.minimum="2pt"
                                            space-before.maximum="2pt"
                                            id="d1184e3743">
                                 <fo:list-item-label end-indent="label-end()">
                                    <fo:block>•</fo:block>
                                 </fo:list-item-label>
                                 <fo:list-item-body start-indent="body-start()">
                                    <fo:block>
                                       <fo:block>
                                          <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                         xmlns:xlink="http://www.w3.org/1999/xlink"
                                                         internal-destination="org.osgi.service.dmt.DmtData.FORMAT_DATE_TIME">
