                  </fo:table>
               </fo:block>
            </fo:block>
            <fo:block id="i2836847">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>117.12.9</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>LIST Nodes</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">A <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">LIST</fo:inline> node is an interior node representing a
      <fo:inline font-style="italic">collection</fo:inline> of elements. The elements are stored in
      the child nodes of the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">LIST</fo:inline> node, they are called the
      <fo:inline font-style="italic">index nodes</fo:inline>. All index nodes must have the same
      type. The names of the index nodes are synthesized and represent the
      index of the index node. The first node is always named 0 and the
      sibling is 1, 2, etc. The sequence must be continuous and must have no
      missing indexes. A node name is always a string, it is therefore the
      responsibility of the plugin to provide the proper names. The index is
      assumed to be a signed positive integer limiting the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">LIST</fo:inline>
      nodes size to <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Integer.MAX_VALUE</fo:inline> elements.</fo:block>
               <fo:block space-before.minimum="0.5em"
                         space-before.optimum="1em"
                         space-before.maximum="2em"
                         space-after.minimum="0.5em"
                         space-after.optimum="1em"
                         space-after.maximum="2em"
                         keep-together.within-column="always"
                         id="d1184e4057">
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            font-weight="normal"
                            font-size="9pt"
                            hyphenate="false"
                            space-after.minimum="0.4em"
                            space-after.optimum="0.6em"
                            space-after.maximum="0.8em"
                            start-indent="0pt"
                            font-family="Proforma-Book,ArialUnicodeMS"
                            font-style="italic"
                            keep-with-next.within-column="always">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block>Figure 117.26</fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>LIST Nodes</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block id="d1184e4059" text-align="center">
                     <fo:external-graphic src="url(file:///home/stbischof/git/OSGI_MIGRATE/osgi_target/org.osgi.service.dmt/spec/org.osgi.spec.service.dmt/src/main/resources/spec/list-nodes.svg)"
                                          width="auto"
                                          height="auto"
                                          content-width="5.927in"
                                          content-height="1.141in"
                                          text-align="center"/>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Index nodes should only be used for types where the value of the
      index node is the identity. For example, a network interface has an
      identity; a manager will expect that a node representing such as a
      network interface node will always have the same URI even if other
      interfaces are added and deleted. Since <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">LIST</fo:inline> nodes renumber
      the index node names when an element is deleted or added, the URI would
      fail if a network interface was added or removed. If such a case, a
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">MAP</fo:inline> node should be used, see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="i2837021">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">
                        <fo:inline font-style="italic">MAP Nodes</fo:inline> on page <fo:page-number-citation ref-id="i2837021"/>
                     </fo:inline>
                  </fo:basic-link>, as
      they allow the key to be managed by the remote manager.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
                  <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">LIST</fo:inline> nodes can be mutable if the Meta Node of its
      index nodes support the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Add</fo:inline> or <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Delete</fo:inline> action.
      A LIST node is modeled after a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">java.util.List</fo:inline> that can
      automatically accommodate new elements. <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Get</fo:inline> and
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Replace</fo:inline> operations use the node name to index in this
      list.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">To rearrange the list the local manager can <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Add</fo:inline> and
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Delete</fo:inline> nodes or rename them as it sees fit. At any moment
      in time the underlying implementation must maintain a list that runs
      from 0 to <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">max(index)</fo:inline> (inclusive), where index is the name
      of the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">LIST</fo:inline> child nodes. Inserting a node requires renaming
      all subsequent nodes. Any missing indexes must automatically be provided
      by the plugin when the child node names are retrieved.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">For example, a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">LIST</fo:inline> node named <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">L</fo:inline>
      contains the following nodes:</fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d1184e4099">L/0     A
L/1     B
L/2     C</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">To insert a node after <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">B</fo:inline>, <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">L/2</fo:inline> must be
      renamed to <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">L/3</fo:inline>. This will automatically extend the
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">LIST</fo:inline> node to 4 elements. That is, even though
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">L/2</fo:inline> is renamed, the implementation must automatically
      provide a new <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">L/2</fo:inline> node. The value of this node depends on
      the underlying implementation. The value of the list will therefore then
      be: <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">[A,B,?,C]</fo:inline>. If node 1 is deleted, then the list will be
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">[A,?,C]</fo:inline>. If a node L/5 is added then the list will be
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">[A,?,C,?,?,?]</fo:inline>. It is usually easiest to use the LIST node
      as a complex value, this is discussed in the next section.</fo:block>
               <fo:block id="d1184e4121">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>117.12.9.1</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>Complex Collections</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">An implementation of a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                font-size="9pt"
                                letter-spacing="0.08em">LIST</fo:inline> node must support a
        complex node value if its members are primitive; the interior node
        must then have a value of a Java object implementing the
        <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                font-size="9pt"
                                letter-spacing="0.08em">Collection</fo:inline> interface from <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                font-size="9pt"
                                letter-spacing="0.08em">java.util</fo:inline>. The
        elements in this map must be converted according to the following
        table.</fo:block>
                  <fo:block xmlns:rx="http://www.renderx.com/XSL/Extensions"
                            space-before.minimum="0.5em"
                            space-before.optimum="1em"
                            space-before.maximum="2em"
                            space-after.minimum="0.5em"
                            space-after.optimum="1em"
                            space-after.maximum="2em"
                            keep-together.within-column="auto"
                            id="service.dmt-collections.conversion">
                     <fo:block xmlns:d="http://docbook.org/ns/docbook"
                               xmlns:xlink="http://www.w3.org/1999/xlink"
                               space-before.optimum="5pt"
                               space-before.minimum="5pt"
                               space-before.maximum="5pt"
                               font-weight="normal"
                               font-size="9pt"
                               hyphenate="false"
                               space-after.minimum="0.4em"
                               space-after.optimum="0.6em"
                               space-after.maximum="0.8em"
                               start-indent="0pt"
                               font-family="Proforma-Book,ArialUnicodeMS"
                               font-style="italic"
                               keep-with-next.within-column="always">
                        <fo:list-block provisional-distance-between-starts="1in"
                                       provisional-label-separation="0.090in">
                           <fo:list-item>
                              <fo:list-item-label end-indent="label-end()" text-align="start">
                                 <fo:block>Table 117.11</fo:block>
                              </fo:list-item-label>
                              <fo:list-item-body start-indent="body-start()">
                                 <fo:block>Conversion for Collections</fo:block>
                              </fo:list-item-body>
                           </fo:list-item>
                        </fo:list-block>
                     </fo:block>
                     <fo:table border-before-width.conditionality="retain"
                               border-collapse="collapse"
                               table-layout="fixed"
                               width="100%">
                        <fo:table-column column-number="1" column-width="proportional-column-width(2)"/>
                        <fo:table-column column-number="2" column-width="proportional-column-width(5)"/>
                        <fo:table-header start-indent="0pt" end-indent="0pt">
                           <fo:table-row keep-together.within-column="always"
                                         keep-with-next.within-column="always"
                                         font-family="ProductusSemibold,ArialUnicodeMS">
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>
                                    <fo:block space-before.optimum="5pt"
                                              space-before.minimum="5pt"
                                              space-before.maximum="5pt">Format</fo:block>
                                 </fo:block>
                              </fo:table-cell>
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>
                                    <fo:block space-before.optimum="5pt"
                                              space-before.minimum="5pt"
                                              space-before.maximum="5pt">Associated Java Type</fo:block>
                                 </fo:block>
                              </fo:table-cell>
                           </fo:table-row>
                        </fo:table-header>
                        <fo:table-body start-indent="0pt" end-indent="0pt">
                           <fo:table-row keep-together.within-column="always">
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>
                                    <fo:block space-before.optimum="5pt"
                                              space-before.minimum="5pt"
                                              space-before.maximum="5pt">
                                       <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                      xmlns:xlink="http://www.w3.org/1999/xlink"
                                                      internal-destination="org.osgi.service.dmt.DmtData.FORMAT_STRING">
                                          <fo:inline color="blue"
                                                     font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                                     letter-spacing="0.08em"
                                                     hyphenate="false">FORMAT_STRING</fo:inline>
                                       </fo:basic-link>
                                    </fo:block>
                                 </fo:block>
                              </fo:table-cell>
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>
                                    <fo:block space-before.optimum="5pt"
                                              space-before.minimum="5pt"
                                              space-before.maximum="5pt">
                                       <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                                  font-size="9pt"
                                                  letter-spacing="0.08em">String</fo:inline>
                                    </fo:block>
                                 </fo:block>
                              </fo:table-cell>
                           </fo:table-row>
                           <fo:table-row keep-together.within-column="always">
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>
                                    <fo:block space-before.optimum="5pt"
                                              space-before.minimum="5pt"
                                              space-before.maximum="5pt">
                                       <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                      xmlns:xlink="http://www.w3.org/1999/xlink"
                                                      internal-destination="org.osgi.service.dmt.DmtData.FORMAT_BOOLEAN">
