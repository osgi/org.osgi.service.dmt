                               start-indent="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS"
                               font-size="28pt"
                               line-height="35pt"
                               font-weight="normal"
                               space-after="24pt">
                        <fo:list-block provisional-distance-between-starts="1in"
                                       provisional-label-separation="0.090in">
                           <fo:list-item>
                              <fo:list-item-label end-indent="label-end()" text-align="start">
                                 <fo:block>117</fo:block>
                              </fo:list-item-label>
                              <fo:list-item-body start-indent="body-start()">
                                 <fo:block>Dmt Admin Service Specification</fo:block>
                              </fo:list-item-body>
                           </fo:list-item>
                        </fo:list-block>
                     </fo:block>
                  </fo:block>
                  <fo:block>
                     <fo:block xmlns:d="http://docbook.org/ns/docbook"
                               xmlns:xlink="http://www.w3.org/1999/xlink"
                               font-family="ProductusOSGiBookcItalic"
                               font-size="18pt"
                               line-height="25pt">
                        <fo:basic-link internal-destination="org.osgi.service.dmt">
                           <fo:inline color="inherit"
                                      font-family="inherit"
                                      letter-spacing="inherit"
                                      hyphenate="inherit">Version 2.0</fo:inline>
                        </fo:basic-link>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="d1184e87">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Introduction</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>117.1</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Introduction</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">There are a large number of Device Management standards available
    today. Starting with the ITU X.700 series in the seventies, SNMP in the
    eighties and then an explosion of different protocols when the use of the
    Internet expanded in the nineties. Many device management standards have
    flourished, and some subsequently withered, over the last decades. Some
    examples:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d1184e90">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1184e91">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>X.700 CMIP</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1184e93">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>IETF SNMP</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1184e95">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>IETF LDAP</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1184e97">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>OMA DM</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1184e99">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>Broadband Forum TR-069</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1184e101">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>UPnP Forum's Device Management</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1184e103">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>IETF NETCONF</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1184e105">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>OASIS WS Distributed Management</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">This heterogeneity of the remote management for OSGi Framework based
    devices is a problem for device manufacturers. Since there is often no
    dominant protocol these manufacturers have to develop multiple solutions
    for different remote management protocols. It is also problematic for
    device operators since they have to choose a specific protocol but by that
    choice could exclude a class of devices that do not support that protocol.
    There is therefore a need to allow the use of multiple protocols at
    minimal costs.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Almost all management standards are based on hierarchical object
    models and provide <fo:inline font-style="italic">primitives</fo:inline> like:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d1184e112">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1184e113">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>Get and replace values</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1184e115">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>Add/Remove instances</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1184e117">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>Discovery of value names and instance ids</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1184e119">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>Provide notifications</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">A Device Management standard consists of a <fo:inline font-style="italic">protocol
    stack</fo:inline> and a number of <fo:inline font-style="italic">object models</fo:inline>. The
    protocol stack is generic and shared for all object types; the object
    model describes a specific device's properties and methods. For example,
    the protocol stack can consist of a set of SOAP message formats and an
    object model is a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Deployment Unit</fo:inline>. An object model consists
    of a data model and sometimes a set of functions.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The core problem is that the generic Device Management Tree must be
    mapped to device specific functions. This specification therefore defines
    an API for managing a device using general device management concepts but
    providing an effective plugin model to link the generic tree to the
    specific device functions.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The API is decomposed in the following
    packages/functionality:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d1184e131">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1184e132">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">org.osgi.service.dmt</fo:inline> - Main package that provides
        access to the local Device Management Tree. Access is session
        based.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1184e136">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">org.osgi.service.dmt.notification</fo:inline> - The
        notification package provides the capability to send alerts to a
        management server.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1184e140">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">org.osgi.service.dmt.spi</fo:inline> - Provides the capability
        to register subtree handlers in the Device Management Tree.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1184e144">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">org.osgi.service.dmt.notification.spi</fo:inline> - The API to
        provide the possibility to extend the notification system.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d1184e148">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">org.osgi.service.dmt.security</fo:inline> - Permission
        classes.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block id="d1184e152">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>117.1.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Entities</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d1184e154">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e155">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Device Management Tree</fo:inline> - The Device
          Management Tree (DMT) is the logical view of manageable aspects of
          an OSGi Environment, implemented by plugins and structured in a tree
          with named nodes.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e159">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Dmt Admin</fo:inline> - A service through which the
          DMT can be manipulated. It is used by <fo:inline font-style="italic">Local
          Managers</fo:inline> or by <fo:inline font-style="italic">Protocol Adapters</fo:inline>
          that initiate DMT operations. The Dmt Admin service forwards
          selected DMT operations to Data Plugins and execute operations to
          Exec Plugins; in certain cases the Dmt Admin service handles the
          operations itself. The Dmt Admin service is a singleton.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e167">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Dmt Session</fo:inline> - A session groups a set of
          operations on a sub-tree with optional transactionality and locking.
          Dmt Session objects are created by the Dmt Admin service and are
          given to a plugin when they first join the session.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e171">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Local Manager</fo:inline> - A bundle which uses the
          Dmt Admin service directly to read or manipulate the DMT. Local
          Managers usually do not have a principal associated with the
          session.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e175">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Protocol Adapter</fo:inline> - A bundle that
          communicates with a management server external to the device and
          uses the Dmt Admin service to operate on the DMT. Protocol Adapters
          usually have a principal associated with their sessions.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e179">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Meta Node</fo:inline> - Information provided by the
          node implementer about a node for the purpose of performing
          validation and providing assistance to users when these values are
          edited.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e183">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Multi nodes</fo:inline> - Interior nodes that have a
          homogeneous set of children. All these children share the same meta
          node.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e187">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Plugin</fo:inline> - Services which take the
          responsibility over a given sub-tree of the DMT: Data Plugin
          services and Exec Plugin services.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e191">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Data Plugin</fo:inline> - A Plugin that can create a
          Readable Data Session, Read Write Data Session, or Transactional
          Data Session for data operations on a sub-tree for a Dmt
          Session.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e195">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Exec Plugin</fo:inline> - A Plugin that can handle
          execute operations.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e199">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Readable Data Session</fo:inline> - A plugin session
          that can only read.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e204">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Read Write Data Session</fo:inline> - A plugin
          session that can read and write.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e208">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Transactional Data Session</fo:inline> - A plugin
          session that is transactional.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e212">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Principal</fo:inline> - Represents the optional
          identity of an initiator of a Dmt Session. When a session has a
          principal, the Dmt Admin must enforce ACLs and must ignore Dmt
          Permissions.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e216">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">ACL</fo:inline> - An Access Control List is a set of
          principals that is associated with permitted operations.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e220">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Dmt Event</fo:inline> - Information about a
          modification of the DMT.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e224">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Dmt Event Listener</fo:inline> - Listeners to Dmt
          Events. These listeners are services according to the white board
          pattern.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e228">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Mount Point</fo:inline> - A point in the DMT where a
          Plugin or the Dmt Admin service allows other Plugins to have their
          root.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The overall service interaction diagram is depicted in <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="i2818213">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">Figure 117.1</fo:inline>
                  </fo:basic-link>.</fo:block>
