                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e4745">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.dmt.DmtIllegalStateException">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">DmtIllegalStateException</fo:inline>
                                 </fo:inline>
                              </fo:basic-link> - 
Unchecked illegal state exception.
   </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e4753">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.dmt.DmtSession">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">DmtSession</fo:inline>
                                 </fo:inline>
                              </fo:basic-link> - 
DmtSession provides concurrent access to the DMT.
   </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e4761">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.dmt.MetaNode">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">MetaNode</fo:inline>
                                 </fo:inline>
                              </fo:basic-link> - 
The MetaNode contains meta data as standardized by OMA DM but extends it
 (without breaking the compatibility) to provide for better DMT data quality
 in an environment where many software components manipulate this data.
   </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d1184e4769">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.dmt.Uri">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">Uri</fo:inline>
                                 </fo:inline>
                              </fo:basic-link> - 
This class contains static utility methods to manipulate DMT URIs.
   </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
            </fo:block>
            <fo:block id="org.osgi.service.dmt.Acl">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>117.14.2</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>public final class Acl</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
{@code Acl} is an immutable class representing structured access to DMT ACLs.
 Under OMA DM the ACLs are defined as strings with an internal syntax.
 </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
 The methods of this class taking a principal as parameter accept remote
 server IDs (as passed to {@link DmtAdmin#getSession(String, String, int) DmtAdmin.getSession}), as well as " {@code *} " indicating any
 principal.
 </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
 The syntax for valid remote server IDs:
 </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
 &lt;<fo:inline font-style="italic">server-identifier</fo:inline>&gt; ::= All printable characters except
 {@code '='}, {@code '&amp;'}, {@code '*'}, {@code '+'} or white-space characters.</fo:block>
               <fo:block id="org.osgi.service.dmt.Acl.ADD">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>117.14.2.1</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public static final int ADD = 2</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
Principals holding this permission can issue ADD commands on the node
 having this ACL.
   </fo:block>
               </fo:block>
               <fo:block id="org.osgi.service.dmt.Acl.ALL_PERMISSION">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>117.14.2.2</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public static final int ALL_PERMISSION = 31</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
Principals holding this permission can issue any command on the node
 having this ACL. This permission is the logical OR of {@link #ADD},
 {@link #DELETE}, {@link #EXEC}, {@link #GET} and {@link #REPLACE}
 permissions.
   </fo:block>
               </fo:block>
