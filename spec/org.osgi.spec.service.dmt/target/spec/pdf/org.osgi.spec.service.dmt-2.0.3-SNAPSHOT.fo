                              <fo:block>
Get the data contained in a leaf or interior node.
   </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
