                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:block space-before.optimum="5pt"
                                           space-before.minimum="5pt"
                                           space-before.maximum="5pt">Not allowed for a single scaffold node as
              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">nodeUri</fo:inline>, if the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">recurse</fo:inline> parameter is
              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">false</fo:inline> the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                   xmlns:xlink="http://www.w3.org/1999/xlink"
                                                   internal-destination="org.osgi.service.dmt.DmtException">
