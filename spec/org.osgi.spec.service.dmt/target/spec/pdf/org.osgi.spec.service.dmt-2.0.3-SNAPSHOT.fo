                                                     hyphenate="inherit">[13] <fo:inline font-style="italic">XML Schema Part 2: Datatypes Second Edition</fo:inline>
                                          </fo:inline>
                                       </fo:basic-link> as the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                                  font-size="9pt"
                                                  letter-spacing="0.08em">time</fo:inline>
              type.</fo:block>
                                 </fo:block>
                              </fo:table-cell>
                           </fo:table-row>
                           <fo:table-row keep-together.within-column="always">
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
