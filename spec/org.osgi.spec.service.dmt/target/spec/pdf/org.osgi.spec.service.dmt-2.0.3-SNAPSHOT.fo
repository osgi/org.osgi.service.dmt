                                             <fo:block>117.14.5.3</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public static final int FORMAT_BINARY = 64</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
The node holds an OMA DM {@code bin} value. The value of the node
 corresponds to the Java {@code byte[]} type.
   </fo:block>
               </fo:block>
               <fo:block id="org.osgi.service.dmt.DmtData.FORMAT_BOOLEAN">
