               </fo:block>
               <fo:block id="org.osgi.service.dmt.DmtSession.getNodeSize-String-">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>117.14.10.23</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public abstract int getNodeSize(String nodeUri) throws DmtException</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>nodeUri</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>the URI of the leaf node</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:inline font-weight="normal"
                                            font-style="normal"
                                            baseline-shift="-1pt"
                                            font-size="9pt">□</fo:inline>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
Get the size of the data in a leaf node. The returned value depends on
 the format of the data in the node, see the description of the
 {@link DmtData#getSize()} method for the definition of node size for each
 format.
   </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>Returns</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>the size of the data in the node</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>Throws</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">DmtException</fo:inline>– with the following possible error codes:
         <fo:list-block space-before.optimum="1em"
                                                space-before.minimum="0.8em"
                                                space-before.maximum="1.2em"
                                                space-after.optimum="1em"
                                                space-after.minimum="0.8em"
                                                space-after.maximum="1.2em"
                                                provisional-label-separation="0.2em"
                                                provisional-distance-between-starts="12pt"
                                                id="d1184e6930">
                                    <fo:list-item space-before.optimum="2pt"
                                                  space-before.minimum="2pt"
                                                  space-before.maximum="2pt"
                                                  id="d1184e6931">
                                       <fo:list-item-label end-indent="label-end()">
                                          <fo:block>•</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>
                                             <fo:block>{@code INVALID_URI} if {@code nodeUri} is {@code null} or
         syntactically invalid</fo:block>
                                          </fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                    <fo:list-item space-before.optimum="2pt"
                                                  space-before.minimum="2pt"
                                                  space-before.maximum="2pt"
                                                  id="d1184e6933">
                                       <fo:list-item-label end-indent="label-end()">
                                          <fo:block>•</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>
                                             <fo:block>{@code URI_TOO_LONG} if {@code nodeUri} is longer than
         accepted by the {@code DmtAdmin} implementation (especially on
         systems with limited resources)</fo:block>
                                          </fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                    <fo:list-item space-before.optimum="2pt"
                                                  space-before.minimum="2pt"
                                                  space-before.maximum="2pt"
                                                  id="d1184e6935">
                                       <fo:list-item-label end-indent="label-end()">
                                          <fo:block>•</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>
                                             <fo:block>{@code NODE_NOT_FOUND} if {@code nodeUri} points to a
         non-existing node</fo:block>
                                          </fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                    <fo:list-item space-before.optimum="2pt"
                                                  space-before.minimum="2pt"
                                                  space-before.maximum="2pt"
                                                  id="d1184e6937">
                                       <fo:list-item-label end-indent="label-end()">
                                          <fo:block>•</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>
                                             <fo:block>{@code PERMISSION_DENIED} if the session is associated with a
         principal and the ACL of the node does not allow the {@code Get}
         operation for the associated principal</fo:block>
                                          </fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                    <fo:list-item space-before.optimum="2pt"
                                                  space-before.minimum="2pt"
                                                  space-before.maximum="2pt"
                                                  id="d1184e6939">
                                       <fo:list-item-label end-indent="label-end()">
                                          <fo:block>•</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>
                                             <fo:block>{@code COMMAND_NOT_ALLOWED} if the specified node is not a
         leaf node</fo:block>
                                          </fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                    <fo:list-item space-before.optimum="2pt"
                                                  space-before.minimum="2pt"
                                                  space-before.maximum="2pt"
                                                  id="d1184e6941">
                                       <fo:list-item-label end-indent="label-end()">
                                          <fo:block>•</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>
                                             <fo:block>{@code METADATA_MISMATCH} if node information cannot be
         retrieved according to the meta-data (it does not have
         {@code MetaNode.CMD_GET} access type)</fo:block>
                                          </fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                    <fo:list-item space-before.optimum="2pt"
                                                  space-before.minimum="2pt"
                                                  space-before.maximum="2pt"
                                                  id="d1184e6943">
                                       <fo:list-item-label end-indent="label-end()">
                                          <fo:block>•</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>
                                             <fo:block>{@code FEATURE_NOT_SUPPORTED} if the Size property is not
         supported by the DmtAdmin implementation or the underlying plugin
         </fo:block>
                                          </fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                    <fo:list-item space-before.optimum="2pt"
                                                  space-before.minimum="2pt"
                                                  space-before.maximum="2pt"
                                                  id="d1184e6945">
                                       <fo:list-item-label end-indent="label-end()">
                                          <fo:block>•</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>
                                             <fo:block>{@code DATA_STORE_FAILURE} if an error occurred while
         accessing the data store</fo:block>
                                          </fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                    <fo:list-item space-before.optimum="2pt"
                                                  space-before.minimum="2pt"
                                                  space-before.maximum="2pt"
                                                  id="d1184e6947">
                                       <fo:list-item-label end-indent="label-end()">
                                          <fo:block>•</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>
                                             <fo:block>{@code COMMAND_FAILED} if the URI is not within the current
         session's subtree, or if some unspecified error is encountered
         while attempting to complete the command</fo:block>
                                          </fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic"/>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">DmtIllegalStateException</fo:inline>– if the session is already closed or
         invalidated</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic"/>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">SecurityException</fo:inline>– if the caller does not have the necessary
         permissions to execute the underlying management operation, or,
         in case of local sessions, if the caller does not have
         {@code DmtPermission} for the node with the Get action present</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>See Also</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
                                 <fo:basic-link internal-destination="org.osgi.service.dmt.DmtData.getSize--">
                                    <fo:inline color="inherit"
                                               font-family="inherit"
                                               letter-spacing="inherit"
                                               hyphenate="inherit">DmtData.getSize()</fo:inline>
                                 </fo:basic-link>
                              </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
               </fo:block>
               <fo:block id="org.osgi.service.dmt.DmtSession.getNodeTimestamp-String-">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>117.14.10.24</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public abstract Date getNodeTimestamp(String nodeUri) throws DmtException</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>nodeUri</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>the URI of the node</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:inline font-weight="normal"
                                            font-style="normal"
                                            baseline-shift="-1pt"
                                            font-size="9pt">□</fo:inline>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
Get the timestamp when the node was created or last modified.
   </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>Returns</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>the timestamp of the last modification</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>Throws</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">DmtException</fo:inline>– with the following possible error codes:
         <fo:list-block space-before.optimum="1em"
                                                space-before.minimum="0.8em"
                                                space-before.maximum="1.2em"
                                                space-after.optimum="1em"
                                                space-after.minimum="0.8em"
                                                space-after.maximum="1.2em"
                                                provisional-label-separation="0.2em"
                                                provisional-distance-between-starts="12pt"
                                                id="d1184e6985">
                                    <fo:list-item space-before.optimum="2pt"
                                                  space-before.minimum="2pt"
                                                  space-before.maximum="2pt"
                                                  id="d1184e6986">
                                       <fo:list-item-label end-indent="label-end()">
                                          <fo:block>•</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>
                                             <fo:block>{@code INVALID_URI} if {@code nodeUri} is {@code null} or
         syntactically invalid</fo:block>
                                          </fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                    <fo:list-item space-before.optimum="2pt"
                                                  space-before.minimum="2pt"
                                                  space-before.maximum="2pt"
                                                  id="d1184e6988">
                                       <fo:list-item-label end-indent="label-end()">
                                          <fo:block>•</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>
                                             <fo:block>{@code URI_TOO_LONG} if {@code nodeUri} is longer than
         accepted by the {@code DmtAdmin} implementation (especially on
         systems with limited resources)</fo:block>
                                          </fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                    <fo:list-item space-before.optimum="2pt"
                                                  space-before.minimum="2pt"
                                                  space-before.maximum="2pt"
                                                  id="d1184e6990">
                                       <fo:list-item-label end-indent="label-end()">
                                          <fo:block>•</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>
                                             <fo:block>{@code NODE_NOT_FOUND} if {@code nodeUri} points to a
         non-existing node</fo:block>
                                          </fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                    <fo:list-item space-before.optimum="2pt"
                                                  space-before.minimum="2pt"
                                                  space-before.maximum="2pt"
                                                  id="d1184e6992">
                                       <fo:list-item-label end-indent="label-end()">
                                          <fo:block>•</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>
                                             <fo:block>{@code PERMISSION_DENIED} if the session is associated with a
         principal and the ACL of the node does not allow the {@code Get}
         operation for the associated principal</fo:block>
                                          </fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                    <fo:list-item space-before.optimum="2pt"
                                                  space-before.minimum="2pt"
                                                  space-before.maximum="2pt"
                                                  id="d1184e6994">
                                       <fo:list-item-label end-indent="label-end()">
                                          <fo:block>•</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>
                                             <fo:block>{@code METADATA_MISMATCH} if node information cannot be
         retrieved according to the meta-data (it does not have
         {@code MetaNode.CMD_GET} access type)</fo:block>
                                          </fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                    <fo:list-item space-before.optimum="2pt"
                                                  space-before.minimum="2pt"
                                                  space-before.maximum="2pt"
                                                  id="d1184e6996">
                                       <fo:list-item-label end-indent="label-end()">
                                          <fo:block>•</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>
                                             <fo:block>{@code FEATURE_NOT_SUPPORTED} if the Timestamp property is
         not supported by the DmtAdmin implementation or the underlying
         plugin</fo:block>
                                          </fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                    <fo:list-item space-before.optimum="2pt"
                                                  space-before.minimum="2pt"
                                                  space-before.maximum="2pt"
                                                  id="d1184e6998">
                                       <fo:list-item-label end-indent="label-end()">
                                          <fo:block>•</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>
                                             <fo:block>{@code DATA_STORE_FAILURE} if an error occurred while
         accessing the data store</fo:block>
                                          </fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                    <fo:list-item space-before.optimum="2pt"
                                                  space-before.minimum="2pt"
                                                  space-before.maximum="2pt"
                                                  id="d1184e7000">
                                       <fo:list-item-label end-indent="label-end()">
                                          <fo:block>•</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>
                                             <fo:block>{@code COMMAND_FAILED} if the URI is not within the current
         session's subtree, or if some unspecified error is encountered
         while attempting to complete the command</fo:block>
                                          </fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
