                     </fo:block>
                     <fo:block id="d1184e247" text-align="center">
                        <fo:external-graphic src="url(file:///home/stbischof/git/OSGI_MIGRATE/osgi_target/org.osgi.service.dmt/spec/org.osgi.spec.service.dmt/src/main/resources/spec/dmtadmin-classes.svg)"
                                             width="auto"
