                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:inline font-weight="normal"
                                            font-style="normal"
                                            baseline-shift="-1pt"
                                            font-size="9pt">□</fo:inline>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
Set the value of a leaf or interior node. The format of the node is
 contained in the {@code DmtData} object. For interior nodes, the format
 is {@code FORMAT_NODE}, while for leaf nodes this format is never used.
 </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
 If the specified value is {@code null}, the default value must be taken;
 if there is no default value, a {@code DmtException} with error code
 {@code METADATA_MISMATCH} must be thrown.</fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>Throws</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">DmtException</fo:inline>– with the following possible error codes:
         <fo:list-block space-before.optimum="1em"
                                                space-before.minimum="0.8em"
                                                space-before.maximum="1.2em"
                                                space-after.optimum="1em"
                                                space-after.minimum="0.8em"
                                                space-after.maximum="1.2em"
                                                provisional-label-separation="0.2em"
                                                provisional-distance-between-starts="12pt"
                                                id="d1184e9049">
                                    <fo:list-item space-before.optimum="2pt"
                                                  space-before.minimum="2pt"
                                                  space-before.maximum="2pt"
                                                  id="d1184e9050">
                                       <fo:list-item-label end-indent="label-end()">
                                          <fo:block>•</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>
                                             <fo:block>{@code NODE_NOT_FOUND} if {@code nodePath} points to a
         non-existing node</fo:block>
                                          </fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                    <fo:list-item space-before.optimum="2pt"
                                                  space-before.minimum="2pt"
                                                  space-before.maximum="2pt"
                                                  id="d1184e9052">
                                       <fo:list-item-label end-indent="label-end()">
                                          <fo:block>•</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>
                                             <fo:block>{@code METADATA_MISMATCH} if the value
         could not be set because of meta-data restrictions</fo:block>
                                          </fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                    <fo:list-item space-before.optimum="2pt"
                                                  space-before.minimum="2pt"
                                                  space-before.maximum="2pt"
                                                  id="d1184e9054">
                                       <fo:list-item-label end-indent="label-end()">
                                          <fo:block>•</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>
                                             <fo:block>
         {@code FEATURE_NOT_SUPPORTED} if the specified node is an
         interior node and does not support Java object values</fo:block>
                                          </fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                    <fo:list-item space-before.optimum="2pt"
                                                  space-before.minimum="2pt"
                                                  space-before.maximum="2pt"
                                                  id="d1184e9056">
                                       <fo:list-item-label end-indent="label-end()">
                                          <fo:block>•</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>
                                             <fo:block>
         {@code DATA_STORE_FAILURE} if an error occurred while accessing
         the data store</fo:block>
                                          </fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                    <fo:list-item space-before.optimum="2pt"
                                                  space-before.minimum="2pt"
                                                  space-before.maximum="2pt"
                                                  id="d1184e9058">
                                       <fo:list-item-label end-indent="label-end()">
                                          <fo:block>•</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>
                                             <fo:block>{@code COMMAND_FAILED} if some unspecified
         error is encountered while attempting to complete the command
         </fo:block>
                                          </fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic"/>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">SecurityException</fo:inline>– if the caller does not have the necessary
         permissions to execute the underlying management operation</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>See Also</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">DmtSession.setNodeValue(String, DmtData)</fo:inline>
                              </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block id="org.osgi.service.dmt.spi.TransactionalDataSession">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>117.15.8</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>public abstract TransactionalDataSession<fo:block line-height="0pt"/> extends ReadWriteDataSession</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
Provides atomic read-write access to the part of the tree handled by the
 plugin that created this session.
   </fo:block>
               <fo:block id="org.osgi.service.dmt.spi.TransactionalDataSession.commit--">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>117.15.8.1</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public abstract void commit() throws DmtException</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:inline font-weight="normal"
                                            font-style="normal"
                                            baseline-shift="-1pt"
                                            font-size="9pt">□</fo:inline>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
Commits a series of DMT operations issued in the current atomic session
 since the last transaction boundary. Transaction boundaries are the
 creation of this object that starts the session, and all subsequent
 {@link #commit()} and {@link #rollback()} calls.
 </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
 This method can fail even if all operations were successful. This can
 happen due to some multi-node semantic constraints defined by a specific
 implementation. For example, node A can be required to always have
 children A/B, A/C and A/D. If this condition is broken when
 {@code commit()} is executed, the method will fail, and throw a
 {@code METADATA_MISMATCH} exception.
 </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
 In many cases the tree is not the only way to manage a given part of the
 system. It may happen that while modifying some nodes in an atomic
 session, the underlying settings are modified in parallel outside the
 scope of the DMT. If this is detected during commit, an exception with
 the code {@code CONCURRENT_ACCESS} is thrown.</fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>Throws</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">DmtException</fo:inline>– with the following possible error codes
         <fo:list-block space-before.optimum="1em"
                                                space-before.minimum="0.8em"
                                                space-before.maximum="1.2em"
                                                space-after.optimum="1em"
                                                space-after.minimum="0.8em"
                                                space-after.maximum="1.2em"
                                                provisional-label-separation="0.2em"
                                                provisional-distance-between-starts="12pt"
                                                id="d1184e9092">
                                    <fo:list-item space-before.optimum="2pt"
                                                  space-before.minimum="2pt"
                                                  space-before.maximum="2pt"
                                                  id="d1184e9093">
                                       <fo:list-item-label end-indent="label-end()">
                                          <fo:block>•</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>
                                             <fo:block>{@code METADATA_MISMATCH} if the operation failed because of
         meta-data restrictions</fo:block>
                                          </fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                    <fo:list-item space-before.optimum="2pt"
                                                  space-before.minimum="2pt"
                                                  space-before.maximum="2pt"
                                                  id="d1184e9095">
                                       <fo:list-item-label end-indent="label-end()">
                                          <fo:block>•</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>
                                             <fo:block>{@code CONCURRENT_ACCESS} if it is
         detected that some modification has been made outside the scope
         of the DMT to the nodes affected in the session's operations</fo:block>
                                          </fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                    <fo:list-item space-before.optimum="2pt"
                                                  space-before.minimum="2pt"
                                                  space-before.maximum="2pt"
                                                  id="d1184e9097">
                                       <fo:list-item-label end-indent="label-end()">
                                          <fo:block>•</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>
                                             <fo:block> {@code DATA_STORE_FAILURE} if an error occurred while
         accessing the data store</fo:block>
                                          </fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                    <fo:list-item space-before.optimum="2pt"
                                                  space-before.minimum="2pt"
                                                  space-before.maximum="2pt"
                                                  id="d1184e9099">
                                       <fo:list-item-label end-indent="label-end()">
                                          <fo:block>•</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>
                                             <fo:block>{@code COMMAND_FAILED} if some
         unspecified error is encountered while attempting to complete the
         command</fo:block>
                                          </fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic"/>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">SecurityException</fo:inline>– if the caller does not have the necessary
         permissions to execute the underlying management operation</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
               </fo:block>
               <fo:block id="org.osgi.service.dmt.spi.TransactionalDataSession.rollback--">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>117.15.8.2</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public abstract void rollback() throws DmtException</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:inline font-weight="normal"
                                            font-style="normal"
                                            baseline-shift="-1pt"
                                            font-size="9pt">□</fo:inline>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
Rolls back a series of DMT operations issued in the current atomic
 session since the last transaction boundary. Transaction boundaries are
 the creation of this object that starts the session, and all subsequent
 {@link #commit} and {@link #rollback} calls.
   </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>Throws</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">DmtException</fo:inline>– with the error code {@code ROLLBACK_FAILED} in case
         the rollback did not succeed</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic"/>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">SecurityException</fo:inline>– if the caller does not have the necessary
         permissions to execute the underlying management operation</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="org.osgi.service.dmt.notification">
