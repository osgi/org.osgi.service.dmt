Event type indicating nodes that were replaced.
   </fo:block>
               </fo:block>
               <fo:block id="org.osgi.service.dmt.DmtEvent.SESSION_CLOSED">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
